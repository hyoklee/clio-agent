---
import { ArrowRight } from 'lucide-react';
import NdpBrand from '../NdpBrand.astro';
import Capture from './Capture';
import { captureImage } from '@/lib/captures';
import catalog from '@/assets/tutorials/ndp/ndp-catalog.jpg';
const image = await captureImage(catalog);
---
<section id="ndp" class="ndp not-content" aria-labelledby="ndp-data">
  <div class="copy">
    <p class="status">CLIO v0.9.5-beta.8</p>
    <NdpBrand />
    <h2 id="ndp-data">Find a dataset.<br /><em>Work with its evidence.</em></h2>
    <p>Search National Data Platform catalogs, filter by publisher, and choose the exact files to link or download. Ask CLIO to analyze the data and keep the source identities with your results.</p>
    <p>Connect an existing Endpoint by URL or SSH to query services and retain stream samples in the same workspace.</p>
    <a href="/docs/files/ndp/">Explore NDP in CLIO <ArrowRight size={16} aria-hidden="true" /></a>
    <a href="/docs/examples/ndp-earthscope/">Try the EarthScope example <ArrowRight size={16} aria-hidden="true" /></a>
  </div>
  <Capture client:visible image={image}
    alt="CLIO NDP catalog showing the EarthScope WWMT station with only its CSV selected"
    caption="Real public catalog search, captured 18 October 2026. Select measurements separately from preview images and dashboards."
    sizes="(min-width: 64rem) 34rem, 100vw" />
</section>
<style>
  .ndp { display: grid; gap: 2rem; align-items: start; padding-block: 3rem; border-top: 1px solid var(--line); scroll-margin-top: 5rem; }
  .copy { min-width: 0; }
  .status { margin: 0 0 1.2rem; font-size: .8rem; color: var(--muted); }
  h2 { margin: 1.5rem 0 1rem; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.8rem, 3vw, 2.7rem); line-height: 1.15; color: var(--ink); }
  h2 em { color: var(--accent); }
  p { color: var(--ink-soft); line-height: 1.65; max-width: 52ch; }
  p + p { margin-top: .75rem; }
  a { display: flex; width: fit-content; align-items: center; gap: .4rem; margin-top: 1rem; color: var(--accent); font-weight: 600; text-decoration: none; }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (min-width: 64rem) { .ndp { grid-template-columns: 1fr 1fr; gap: 4rem; } }
</style>
